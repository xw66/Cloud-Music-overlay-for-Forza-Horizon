<UserControl x:Class="HorizonRadioOverlay.Views.Pages.RemoteControlPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HorizonRadioOverlay"
             xmlns:viewmodels="clr-namespace:HorizonRadioOverlay.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:RemoteControlViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource PageTitleTextStyle}" Text="{x:Static local:UiText.RemoteControl}" />

            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{x:Static local:UiText.RemoteControl}" />
                        <CheckBox x:Name="EnableRemoteControlCheckBox"
                                  DockPanel.Dock="Right"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  Content="{x:Static local:UiText.EnableRemoteControl}"
                                  IsChecked="{Binding EnableRemoteControl, Mode=TwoWay}" />
                    </DockPanel>
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource BodyTextStyle}" Text="{x:Static local:UiText.RemoteControlDesc}" />

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="{x:Static local:UiText.RemoteControlPort}" />
                        <TextBox x:Name="RemoteControlPortBox" Grid.Column="1" Text="{Binding PortText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    </Grid>

                    <CheckBox x:Name="RemoteControlAllowLanCheckBox"
                              Margin="160,14,0,0"
                              Content="{x:Static local:UiText.RemoteControlAllowLan}"
                              IsChecked="{Binding AllowLan, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{x:Static local:UiText.RemoteControlStatus}" />
                        <TextBlock x:Name="RemoteControlStatusText"
                                   Margin="0,8,0,0"
                                   Style="{StaticResource BodyTextStyle}"
                                   Text="{Binding StatusText}" />

                        <TextBlock Margin="0,22,0,0" Style="{StaticResource SectionTitleTextStyle}" Text="{x:Static local:UiText.RemoteControlAddress}" />
                        <TextBox x:Name="RemoteControlAddressBox"
                                 Margin="0,10,0,0"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 Text="{Binding Address, Mode=OneWay}" />

                        <TextBlock x:Name="RemoteControlHelpText"
                                   Margin="0,10,0,0"
                                   Style="{StaticResource BodyTextStyle}"
                                   TextWrapping="Wrap"
                                   Text="{Binding HelpText}" />

                        <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                            <Button x:Name="CopyRemoteAddressButton"
                                    Width="112"
                                    Height="38"
                                    Margin="0,0,12,0"
                                    Content="{x:Static local:UiText.CopyRemoteAddress}"
                                    Command="{Binding CopyAddressCommand}" />
                            <Button x:Name="ResetRemoteTokenButton"
                                    Width="132"
                                    Height="38"
                                    Content="{x:Static local:UiText.ResetRemoteToken}"
                                    Command="{Binding ResetTokenCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="24,0,0,0">
                        <TextBlock HorizontalAlignment="Center" Style="{StaticResource SectionTitleTextStyle}" Text="{x:Static local:UiText.RemoteControlQr}" />
                        <Border Margin="0,12,0,0"
                                Padding="10"
                                Width="200"
                                Height="200"
                                Background="White"
                                CornerRadius="8">
                            <Image x:Name="RemoteControlQrImage"
                                   Stretch="Uniform"
                                   Source="{Binding QrCodeImage}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
